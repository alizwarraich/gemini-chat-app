generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
    user
    model
}

model User {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    email     String   @unique
    password  String
    name      String
    sessions  Session[]
}

model Message {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  content   String
  role      Role
  session   Session  @relation(fields: [sessionId], references: [id])
  sessionId String
}

model Session {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    messages  Message[]
    users     User[]
}